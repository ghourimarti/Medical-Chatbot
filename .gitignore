*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment / secrets
.env
.env.*
*.pem

# Logs
logs/
*.log

# medeval curation cache (regenerate with extract_corpus.py --build-cache)
.cache/

