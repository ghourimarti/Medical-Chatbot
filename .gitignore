*.pdf
*.faiss
*.pkl
vectorstore/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only folders. The leading slash matters: unanchored `Prompts/` matches a directory
# of that name at any depth, and case-insensitively on Windows, so it also swallowed
# packages/core/src/medcore/prompts/ and the safety policy never reached git. A fresh clone
# then failed to start with `prompt system_v1 not found; available: []`.
/demo/
.terraform/
*.tfstate
*.tfstate.*
/Documents/

# Node / Next.js. Unanchored here means "at any depth", which is what we want since these
# are generated in every app directory. Anything that should match only at the repo root
# gets a leading slash.
#
# Note: git only treats `#` as a comment at the start of a line, so `node_modules/  # note`
# is a pattern matching a path containing that text, and the rule silently does nothing.
node_modules/
.next/
out/
next-env.d.ts
.turbo/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/

# HuggingFace cache; an 86 MB safetensors blob got committed from here once.
# Containers use HF_HOME=/models backed by the named `hf_models` volume, never this dir.
/hub/

# Working notes kept locally, not part of the published repo.
update_todos*.md
docs/update_todos*.md
docs/TRANSFORMATION_PLAN.md
docs/learn/
docs/learn_docs/
docs/learning/

# Personal prep notes, not published.
BRIEFING.local.md
*.local.md
